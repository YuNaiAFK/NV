<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="AppTheme" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>

        <item name="colorPrimary">@color/nv_primary</item>
        <item name="colorPrimaryVariant">?attr/colorSurface</item>
        <item name="colorOnPrimary">@color/nv_on_primary</item>
        <item name="colorPrimaryContainer">@color/nv_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/nv_on_primary_container</item>
        <item name="colorSurface">@color/nv_surface</item>
        <item name="colorOnSurface">@color/nv_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/nv_on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/nv_surface_low</item>
        <item name="colorSurfaceContainerHigh">@color/nv_surface_high</item>
        <item name="colorOutlineVariant">@color/nv_outline_variant</item>
        <item name="android:colorBackground">@color/nv_surface</item>
        <item name="android:windowBackground">@color/nv_surface</item>
        <item name="colorAccent">@color/nv_primary</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/nv_surface</item>
    </style>


    <style name="AppTheme.Black" parent="AppTheme">
        <item name="colorSurface">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorBackground">#000000</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerHigh">#161219</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">#000000</item>
        <item name="colorPrimaryVariant">#000000</item>
        <item name="cardViewStyle">@style/BlackCardView</item>
    </style>

    <style name="BlackCardView" parent="CardView">
        <item name="cardBackgroundColor">#000000</item>
    </style>

</resources>
